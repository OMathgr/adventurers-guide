# Copie para .env (na mesma pasta) e preencha. O .env NÃO vai para o git.

# Endereço do site (o subdomínio do DuckDNS, sem https://)
DOMINIO=adventurersguide.duckdns.org

# Chave dos logins: longa e aleatória. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar depois derruba todos os logins.
JWT_SECRET=

# Validade do login sem uso (minutos)
JWT_EXPIRA_MINUTOS=120

# E-mail do "esqueci minha senha" (opcional; sem SMTP_HOST, o link vai para o log)
# Gmail: SMTP_HOST=smtp.gmail.com, porta 587, e uma "senha de app" da conta Google.
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURANCA=starttls
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Login com o Google (opcional; sem isto o botão não aparece).
# No Google Cloud Console, cadastre o retorno: https://SEU-DOMINIO/api/auth/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quantas cópias diárias do banco guardar
BACKUPS_GUARDADOS=14
